def _t_otr2_file(t: T, name: str, plain: bytes, cek: bytes, size: Optional[int] = None) -> Path:
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    nonce = os.urandom(12)
    head = json.dumps({"scheme": OTR2_SCHEME, "rec": "rec-1", "iv": nonce.hex(),
                       "size": len(plain) if size is None else size, "content_type": "video/mp4"}).encode()
    pre = OTR2_MAGIC + (1).to_bytes(2, "little") + b"\0\0" + len(head).to_bytes(4, "little") + b"\0" * 4
    pad = b"\0" * ((-(len(pre) + len(head))) % OTR2_ALIGN)
    enc = Cipher(algorithms.AES(cek), modes.CTR(nonce + b"\0\0\0\0")).encryptor()
    p = t.dir / name
    p.write_bytes(pre + head + pad + enc.update(plain) + enc.finalize())
    return p


def _t_key_server(t: T, cek: bytes, sha: str) -> None:
    """OTR's three hosts, faked: the key wrapped to the client's public key."""
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import ec
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF

    def key(req: urllib.request.Request) -> Reply:
        body = cast(Dict[str, str], json.loads(req.data if isinstance(req.data, bytes) else b"{}"))
        client = serialization.load_der_public_key(base64.b64decode(body["client_pub"]))
        assert isinstance(client, ec.EllipticCurvePublicKey)
        eph = ec.generate_private_key(ec.SECP256R1())
        kek = HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=ECIES_INFO.encode()).derive(
            eph.exchange(ec.ECDH(), client))
        nonce = os.urandom(12)
        wrapped = eph.public_key().public_bytes(serialization.Encoding.X962,
                                                serialization.PublicFormat.UncompressedPoint)
        wrapped += nonce + AESGCM(kek).encrypt(nonce, cek, None)
        return Reply(200, json.dumps({"wrapped_cek": base64.b64encode(wrapped).decode(),
                                      "plaintext_sha256": sha}).encode())

    t.routes[f"{OTR_API}/api/auth/login"] = lambda req: Reply(200, b'{"token": "jwt", "user": {"id": 7}}')
    t.routes[f"{OTR_API}/api/otr2/ticket"] = lambda req: Reply(200, b'{"ticket": "tk", "exp": 9999999999}')
    t.routes[f"{OTR_KEYS}/key"] = key


def t_decode_otr2(t: T) -> None:
    plain, cek = os.urandom(70000) + b"tail", os.urandom(32)
    src = _t_otr2_file(t, "Foo_26.10.04_10-15_zdf_100_TVOON_DE.HQ.otr2", plain, cek)
    _t_key_server(t, cek, hashlib.sha256(plain).hexdigest().upper())
    rc, out, errs = t.run(["--config", str(t.config()), "decode", str(src), str(t.dir)])
    got = t.dir / "Foo_26.10.04_10-15_zdf_100_TVOON_DE.HQ.mp4"
