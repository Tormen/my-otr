LEGACY: Final = {"--search", "--get", "--dl", "--download", "--decode", "--login"}


@dataclass
class Cli:
    command: Optional[str] = None
    args: List[str] = field(default_factory=lambda: [])
    quiet: Optional[bool] = None
    vrb: Optional[bool] = None
    dbg: Optional[bool] = None
    force: Optional[bool] = None
    log: Optional[bool] = None
    log_file: Optional[str] = None
    config: Optional[str] = None
    no_decode: bool = False


def parse_cli(argv: Sequence[str]) -> Cli:
    """Options anywhere (as callers put them after the command); '--' ends them."""
    c = Cli()
    it = iter(argv)
    rest = False
    for a in it:
        if rest or not a.startswith("-") or a == "-":
            if c.command is None:
                if a not in COMMANDS:
                    hint = f" -- you mean `{SCRIPT_NAME} decode {a}`" if a.lower().endswith((".otrkey", ".otr2")) else ""
                    err("00064", f"'{a}' is no command{hint} ({SCRIPT_NAME} --help)")
                c.command = COMMANDS[a]
            else:
                c.args.append(a)
            continue
        key, eq, val = a.partition("=")
        if a == "--":
            rest = True
        elif a in LEGACY:
            if c.command is not None:
                err("00065", f"one command only -- '{c.command}' and '{a}'")
            c.command = COMMANDS[a[2:]]
        elif a in ("-Q", "--quiet"):
            c.quiet = True
        elif a in ("-V", "--verbose"):
            c.vrb = True
        elif a in ("-D", "--debug"):
            c.dbg = True
        elif a in ("-F", "--force"):
            c.force = True
        elif a in ("-l", "--log"):
            c.log = True
        elif a in ("-L", "--no-log"):
            c.log = False
        elif key in ("--log-file", "--config"):
            v = val if eq else next(it, None)
            if not v:
                err("00066", f"{key} needs a <FILE>")
            if key == "--config":
                c.config = v
            else:
                c.log_file, c.log = v, True
        elif a == "--no-decode":
            c.no_decode = True
        elif a in ("-h", "--help"):
            c.command = "help"
        else:
            verb = a.lstrip("-")
            hint = f" -- you mean `{SCRIPT_NAME} {verb}`" if verb in COMMANDS else f" ({SCRIPT_NAME} --help)"
            err("00067", f"no such option '{a}'{hint}")
    if c.no_decode and c.command != "get":
        err("00068", "--no-decode goes with 'get'")
    return c


def setup_output(s: Settings, c: Cli, argv: Sequence[str]) -> None:
    OUT.dbg_on = c.dbg if c.dbg is not None else s.dbg
    OUT.vrb = OUT.dbg_on or (c.vrb if c.vrb is not None else s.vrb)
    OUT.quiet = (c.quiet if c.quiet is not None else s.quiet) and not OUT.vrb   # -V beats -Q
    if c.log if c.log is not None else s.log:
        logfile = Path(c.log_file or s.logfile).expanduser()
        try:
            logfile.parent.mkdir(parents=True, exist_ok=True)
            OUT.log = logfile.open("a", encoding="utf-8")
        except OSError as e:
            err("00069", f"cannot write the LOGFILE {logfile}: {e.strerror} (-L runs without one)")
        OUT.record(f"==== {SCRIPT_NAME} {shlex.join(argv)}   [in {Path.cwd()}]")


def create_config(target: Optional[str]) -> int:
    if target is None:
        sys.stdout.write(DEFAULT_CONFIG)
        return 0
    p = Path(target)
    try:
        with p.open("x", encoding="utf-8") as f:
            f.write(DEFAULT_CONFIG)
    except FileExistsError:
        err("00070", f"{p} exists -- never written over (compare it with `{SCRIPT_NAME} --create-config`)")
    OUT.msg(f" >>> wrote the default config to {p}")
    return 0


def run(argv: Sequence[str]) -> int:
    first, _, value = (argv[0] if argv else "").partition("=")
    if first == "--run-tests":
        return run_tests(argv[1] if len(argv) > 1 else "")
    if first == "--version":
        OUT.result(version_line())
        return 0
    if first == "--create-config":
        return create_config(value or (argv[1] if len(argv) > 1 else None))
    c = parse_cli(argv)
    if c.command in (None, "help"):
        OUT.result(HELP)
        return 0
    if c.command == "update-check":
        if len(c.args) != 1:
            err("00071", "update-check needs the <ZIP> of OTR's decoder")
        return update_check(Path(c.args[0]))
    s = load_settings(c.config)
    setup_output(s, c, argv)
    force = c.force if c.force is not None else s.force
    if c.command == "search":
        return cmd_search(s, c.args)
    if c.command == "decode":
        return cmd_decode(s, c.args, force)
    if c.args:
        err("00072", f"'{c.command}' takes no arguments -- it reads stdin: {' '.join(c.args)[:60]}")
    if c.command == "login":
        datenkeller_login(s, force)
        return 0
    return cmd_get(s, decode=c.command == "get" and not c.no_decode, force=force)


def trace_file() -> Path:
    """Beside the LOGFILE when there is one, else in the temp directory."""
    log = Path(OUT.log.name) if OUT.log is not None else None
    folder = log.parent if log is not None and os.access(log.parent, os.W_OK) else Path(tempfile.gettempdir())
    return folder / f"{SCRIPT_NAME}.{datetime.datetime.now():%Y-%m-%d_%H%M%S}.{os.getpid()}.trace"


def main(argv: Sequence[str]) -> int:
    """Every way a run ends: 0; 1 with ONE error line; 130 on Ctrl-C; 70 and a
    trace file on a bug -- never a traceback on the screen."""
    try:
        return run(argv)
    except OtrError as e:
        OUT.error(f"ERROR {e.code} [1]: {e.text}")
        return 1
    except KeyboardInterrupt:
        OUT.error(f"{SCRIPT_NAME}: interrupted (Ctrl-C) while {_phase} -- what was done before stays, "
                  f"a half-written file is removed; run it again to go on")
        return 130
    except OSError as e:
        OUT.error(f"ERROR 00073 [1]: while {_phase}: {e.strerror or e}" + (f": {e.filename}" if e.filename else ""))
        return 1
    except Exception as e:   # a bug: one line here, the trace in a file
        where = trace_file()
        try:
            where.write_text(f"{version_line()}\nargv: {list(argv)}\n\n{traceback.format_exc()}", encoding="utf-8")
        except OSError:
            where = Path("(not written)")
        OUT.error(f"ERROR 00074 [70]: unexpected {type(e).__name__} while {_phase} -- the trace: {where}")
        return 70
    finally:
        if OUT.log is not None:
            OUT.log.close()
            OUT.log = None


