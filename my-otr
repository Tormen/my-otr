# --- 1. bootstrap ----------------------------------------------------------

VENV_DIR: Final = Path.home() / ".python.venv" / SCRIPT_NAME
# why: AES-256-CTR/-GCM, ECDH P-256, HKDF and Blowfish -- OTR's two file
# formats; the standard library has none of them. >= 43: Blowfish lives in
# cryptography.hazmat.decrepit from that version on.
VENV_DEPS: Final = ("cryptography>=43",)


class _Terminated(Exception):
    """SIGTERM during the setup -- a caller's time limit, say."""


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def bootstrap() -> None:
    """Run inside ~/.python.venv/my-otr: create it on first use, then re-exec there."""
    if Path(sys.prefix).resolve() == VENV_DIR.resolve():
        return
    py = VENV_DIR / "bin" / "python3"
    if not py.is_file():
        build_venv()
    os.execv(str(py), [str(py), os.path.realpath(__file__), *sys.argv[1:]])


def build_venv() -> None:
    """~/.python.venv/my-otr, complete or not at all: built beside it and renamed
    in, so a setup stopped half-way (Ctrl-C, a caller's SIGTERM) removes its half,
    and the half of one killed outright is removed by the next. It runs in $HOME,
    never in the caller's folder -- that may be a volume this process may not read."""
    parent = VENV_DIR.parent
    parent.mkdir(parents=True, exist_ok=True)
    for old in parent.glob(f".{SCRIPT_NAME}.new.*"):
        pid = old.name.rsplit(".", 1)[-1]
        if pid.isdigit() and not _alive(int(pid)):
            shutil.rmtree(old, ignore_errors=True)
    if VENV_DIR.exists() or VENV_DIR.is_symlink():
        # its python3 is gone: the Python it was made from was upgraded away
        print(f" >>> {SCRIPT_NAME}: {VENV_DIR} has no python3 that runs -- built again", file=sys.stderr)
        shutil.rmtree(VENV_DIR, ignore_errors=True)
    print(f" >>> {SCRIPT_NAME}: setting up its Python environment {VENV_DIR} (once): {', '.join(VENV_DEPS)}",
          file=sys.stderr)
    started = time.monotonic()
    new = parent / f".{SCRIPT_NAME}.new.{os.getpid()}"

    def on_term(signum: int, frame: object) -> None:
        raise _Terminated()

    signal.signal(signal.SIGTERM, on_term)
    home = str(Path.home())
    try:
        subprocess.run([sys.executable, "-m", "venv", str(new)], check=True, cwd=home)
        subprocess.run([str(new / "bin" / "python3"), "-m", "pip", "install", "--quiet",
                        "--disable-pip-version-check", *VENV_DEPS], check=True, cwd=home)
        try:
            new.rename(VENV_DIR)
        except OSError:
            if not (VENV_DIR / "bin" / "python3").is_file():
                raise
            shutil.rmtree(new, ignore_errors=True)   # another run set it up first
    except (OSError, subprocess.CalledProcessError) as e:
        shutil.rmtree(new, ignore_errors=True)
        print(f"ERROR 00001 [1]: cannot set up {VENV_DIR}: {e}", file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, _Terminated) as e:
        shutil.rmtree(new, ignore_errors=True)
        how, rc = ("Ctrl-C", 130) if isinstance(e, KeyboardInterrupt) else ("SIGTERM", 143)
        print(f"{SCRIPT_NAME}: stopped ({how}) while setting up {VENV_DIR} after "
              f"{time.monotonic() - started:.0f}s -- nothing is left of it; the next run starts over",
              file=sys.stderr)
        sys.exit(rc)
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
    print(f" >>> {SCRIPT_NAME}: its Python environment is ready [{time.monotonic() - started:.0f}s]",
          file=sys.stderr)


# --- 2. output, errors -----------------------------------------------------

class OtrError(Exception):
    """The tool's one failure: a code naming the source line, and what to know."""

    def __init__(self, code: str, text: str) -> None:
        super().__init__(f"{code}: {text}")
        self.code = code
        self.text = text


def err(code: str, text: str) -> NoReturn:
    raise OtrError(code, text)


class Out:
    """Where every line goes. stdout carries results only; the narration goes
    to stderr (silenced by -Q) and, whatever -Q says, to the LOGFILE."""

    def __init__(self) -> None:
        self.quiet = False
        self.vrb = False
        self.dbg_on = False
        self.log: Optional[IO[str]] = None

    def record(self, text: str) -> None:
        if self.log is None:
            return
        stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        for line in text.splitlines() or [""]:
            self.log.write(f"{stamp} [{os.getpid()}] {line}\n")
        self.log.flush()

    def _say(self, text: str, shown: bool) -> None:
        self.record(text)
        if shown:
            print(text, file=sys.stderr, flush=True)

    def msg(self, text: str) -> None:
        self._say(text, not self.quiet)

    def det(self, text: str) -> None:
        if self.vrb:
            self._say(text, not self.quiet)

    def dbg(self, text: str) -> None:
        if self.dbg_on:
            self._say(" ~~~ " + text, True)

    def warn(self, text: str) -> None:
        self._say("WARNING: " + text, True)

    def error(self, text: str) -> None:
        self._say(text, True)

    def result(self, line: str) -> None:
        print(line, flush=True)


OUT = Out()
_phase = "starting"


def phase(text: str) -> None:
    """What the run is doing now -- the Ctrl-C line names it."""
    global _phase
    _phase = text
    OUT.dbg(f"phase: {text}")


