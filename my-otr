# --- the programmed recordings: a stand-in for the child my-otr -----------

CHILD_STUB: Final = """\
import os, subprocess, sys, time
calls = {calls!r}
args = sys.argv[1:]
i, verb = 0, ""
while i < len(args):
    if args[i] in ("--config", "--log-file"):
        i += 2
        continue
    if args[i] in ("-L", "-Q", "-D"):
        i += 1
        continue
    verb = args[i]
    break
words = args[i + 1:]
with open(calls, "a") as f:
    f.write(verb + " " + " ".join(words) + " @" + os.getcwd() + "\\n")
if verb == "search":
    title = words[0] if words else ""
    if "broken" in title:
        sys.exit(3)
    if "hang" in title:
        subprocess.Popen(["/bin/sleep", "31.7"])
        time.sleep(31.7)
    n = 3 if "three" in title else 1 if "one" in title else 0
    for k in range(n):
        print(f"{{title.replace(' ', '_')}}_{{k}}_26.10.0{{k + 1}}_20-15_zdf_45_TVOON_DE.HQ.otr2")
elif verb == "get":
    with open(calls, "a") as f:
        for line in sys.stdin:
            f.write("got " + line.strip() + " @" + os.getcwd() + "\\n")
"""


def _t_child(t: T) -> Path:
    """The child my-otr replaced by a stand-in; the calls it gets, in a file."""
    global _child
    calls = t.dir / "calls"
    (t.dir / "child.py").write_text(CHILD_STUB.format(calls=str(calls)), encoding="utf-8")
    _child = [sys.executable, str(t.dir / "child.py")]
    return calls


def _t_rec_config(t: T, recordings: str, extra: str = "") -> Path:
    (t.dir / "rec").write_text(recordings, encoding="utf-8")
    (t.dir / "mail").write_text(f"#!/bin/sh\nprintf '%s|' \"$@\" >> '{t.dir}/mails'; echo >> '{t.dir}/mails'\n")
    (t.dir / "after").write_text(f"#!/bin/sh\necho ran >> '{t.dir}/after.ran'\n")
    (t.dir / "mail").chmod(0o755)
    (t.dir / "after").chmod(0o755)
    return t.config(f'RECORDINGS_FILE="{t.dir}/rec"\nLIBRARY_DIR="{t.dir}/lib"\nSLEEP_SECONDS="0"\n'
                    f'FAIL_MAIL_CMD="{t.dir}/mail"\nRUN_AFTER_REFRESH="{t.dir}/after"\n' + extra)


