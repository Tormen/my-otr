def t_decode_otrkey(t: T) -> None:
    key = os.urandom(16)
    head = b"FN=Foo_23.10.30_19-20_zdfneo_55_TVOON_DE.mpg.mp4.otrkey&OH=abc123&SZ=1"
    head += b"\0" * (OTRKEY_HEADER - len(head))
    plain = os.urandom(8 * 4000) + b"12345"                      # a tail under 8 bytes stays plain
    src = t.dir / "Foo_23.10.30_19-20_zdfneo_55_TVOON_DE.mpg.mp4.otrkey"
    src.write_bytes(OTRKEY_MAGIC + OtrBlowfish(OTRKEY_HEADER_KEY).encrypt(head)
                    + OtrBlowfish(key).encrypt(plain[:-5]) + plain[-5:])
    t.routes[OTR_QUELLE] = lambda req: Reply(200, json.dumps({"random_key": key.hex()}).encode())
    rc, out, errs = t.run(["--config", str(t.config()), "decode", str(src), str(t.dir)])
    got = t.dir / "Foo_23.10.30_19-20_zdfneo_55_TVOON_DE.mpg.mp4"
    t.check(rc == 0 and got.is_file() and got.read_bytes() == plain, f"decoded byte for byte: rc {rc}: {errs}")
    sent = urllib.parse.parse_qs(t.requests[-1][2].decode())
    t.check(sent.get("OH") == ["abc123"] and sent.get("FN") == [src.name], f"FN and OH from the header: {sent}")
    t.no_secret(out + errs, "decode's output")
    t.routes[OTR_QUELLE] = lambda req: Reply(200, b'{"error": "denied", "message": "no decodes left"}')
    src.write_bytes(OTRKEY_MAGIC + OtrBlowfish(OTRKEY_HEADER_KEY).encrypt(head) + b"x" * 64)
    rc, _, errs = t.run(["--config", str(t.config()), "-F", "decode", str(src), str(t.dir)])
    t.check(rc == 1 and "no decodes left" in errs and src.exists(), f"a refusal says OTR's reason: {errs}")
    # the variant pinned: the standard Blowfish (Schneier's vector), on byte-swapped words
    from cryptography.hazmat.decrepit.ciphers.algorithms import Blowfish
    from cryptography.hazmat.primitives.ciphers import Cipher, modes
    std = Cipher(Blowfish(bytes(8)), modes.ECB()).encryptor().update(bytes(8))
    t.check(std.hex() == "4ef997456198dd78", f"cryptography's Blowfish is the standard one: {std.hex()}")
    t.check(OtrBlowfish(bytes(8)).encrypt(bytes(8)) == _swap32(std), "OTR's: the words swapped around it")


