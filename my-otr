def t_version(t: T) -> None:
    rc, out, _ = t.run(["--version"])
    build = hashlib.sha256(Path(os.path.realpath(__file__)).read_bytes()).hexdigest()[:12]
    t.check(rc == 0 and out.startswith(f"{SCRIPT_NAME} {SCRIPT_VERSION} (") and f"build {build})" in out, out)


TESTS: Final[List[Callable[[T], None]]] = [
    t_search_best_quality, t_search_filters, t_search_fails_loud, t_search_key_off_output,
    t_get_name_forms, t_get_downloads_off_argv, t_get_duplicates, t_decode_otr2, t_decode_otr2_wrong_checksum,
    t_decode_otr2_incomplete, t_decode_otrkey, t_get_decodes_what_is_kept, t_config_read_never_run,
    t_create_config, t_output_layers, t_ctrl_c, t_bug_trace, t_update_check, t_version,
]


def run_tests(name_filter: str) -> int:
    defined = {n for n in globals() if re.fullmatch(r"t_[a-z0-9_]+", n)}
    listed = {f.__name__ for f in TESTS}
    if defined != listed:
        print(f"Bail out! test functions and TESTS differ: {sorted(defined ^ listed)}")
        return 1
    chosen = [f for f in TESTS if name_filter in f.__name__]
    print(f"1..{len(chosen)}", flush=True)
    global _transport
    bad, home = 0, Path.cwd()
    for k, test in enumerate(chosen, 1):
        with tempfile.TemporaryDirectory(prefix="my-otr-tests.") as d:
            t = T(Path(d).resolve())
            os.chdir(t.dir)
            _transport = t.serve
            try:
                test(t)
            except Exception as e:   # a test that crashes fails, and the next one runs
                t.bad.append(f"crashed: {type(e).__name__}: {e}")
                t.bad.extend(traceback.format_exc().splitlines())
            finally:
                _transport = _urllib_transport
                os.chdir(home)
                OUT.__init__()
        print(f"{'not ok' if t.bad else 'ok'} {k} - {test.__name__}", flush=True)
        for b in t.bad:
            print(f"#   {b}")
        bad += bool(t.bad)
    return 1 if bad else 0


