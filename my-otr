    t.check(got.is_file() and got.read_bytes() == plain, "decoded byte for byte, named OTR's name + .mp4 (#16)")
    t.check(not src.exists(), "the source is removed once it checked out")
    t.check("= OTR's" in errs, f"the check is said: {errs}")
    t.no_secret(out + errs, "decode's output")
