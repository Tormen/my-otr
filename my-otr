def cmd_search(s: Settings, args: Sequence[str]) -> int:
    filters = parse_filters(args)
    title = " ".join(filters.title)
    phase(f"searching for \"{title}\"")
    OUT.msg(f" >>> searching otr.datenkeller.net for \"{title}\"")
    answer = datenkeller_api(s, f"suche={urllib.parse.quote(title)}&details&limit=-1")
    if not answer.strip():
        err("00060", f"otr.datenkeller.net answered nothing for \"{title}\"")
    best, offered = pick_best(answer, filters, s.quality_cap)
    for rec in best:
        OUT.result(rec.name)
    OUT.msg(f"    > {len(best)} recording(s) [{offered} file(s) offered]")
    return 0


@dataclass
class Tally:
    read: int = 0
    skipped: int = 0
    downloaded: int = 0
    decoded: int = 0
    failed: List[str] = field(default_factory=lambda: [])


def cmd_get(s: Settings, decode: bool, force: bool) -> int:
    """Download the names (or URLs) on stdin into the current folder; then,
    unless --no-decode, decode every complete OTR file in it (#17)."""
    folder = Path.cwd()
    phase("reading the names on stdin")
    lines = [ln for ln in sys.stdin.read().splitlines() if ln.strip()]
    names = [name_of_line(ln) for ln in lines]   # every line checked before anything is fetched
    t = Tally(read=len(names))
    if names:
        datenkeller_login(s, force)
    for name in names:
        rec = parse_otr_name(name)
        assert rec is not None, "name_of_line returns names that parse"
        if rec.unknown:
            OUT.warn(f"{name}: the quality '{rec.unknown}' is new -- my-otr does not know it yet; skipped")
            t.skipped += 1
            continue
        if rec.quality is None:
            OUT.det(f"    > {name}: an add-on, not a recording -- skipped")
            t.skipped += 1
            continue
        here = None if force else as_good_here(rec, rec.quality, folder, s.quality_cap)
        if here is not None:
            OUT.det(f"    > {name}: here already as {here[0].name} [{here[1]}] -- skipped")
            t.skipped += 1
            continue
        try:
            url = download_link(s, name)
            OUT.msg(f" >>> downloading {name}")
            aria2c(s, url, name, folder)
            t.downloaded += 1
        except OtrError as e:
            OUT.error(f"ERROR {e.code} [1]: {e.text}")
            t.failed.append(name)
    if decode:
        decode_all(s, sorted(p for p in folder.iterdir() if _kept_recording(p)), folder, force, t)
    OUT.msg(f" >>> {t.read} read: {t.skipped} skipped (here already), {t.downloaded} downloaded, "
            + (f"{t.decoded} decoded" if decode else "none decoded (--no-decode)")
            + (f", {len(t.failed)} FAILED" if t.failed else ""))
    if t.failed:
        err("00061", f"{len(t.failed)} failed: " + ", ".join(t.failed))
    return 0


def _kept_recording(p: Path) -> bool:
    """An OTR recording here, complete, to be decoded: never an add-on, never
    one aria2c is still writing."""
    if p.suffix.lower() not in (".otr2", ".otrkey") or not p.is_file() or unfinished(p):
        return False
    rec = parse_otr_name(p.name)
    return rec is not None and rec.quality is not None


def decode_all(s: Settings, files: Sequence[Path], outdir: Path, force: bool, t: Tally) -> None:
    """Decode each file; one that fails is named and the next one goes on."""
    session: Optional[OtrSession] = None
    for path in files:
        try:
            if not path.is_file():
                err("00062", f"{path}: no such file")
            out = outdir / decoded_name(path)
            if out.exists() and not force:
                OUT.msg(f"    > {path.name}: decoded already as {out.name} -- left as it is (-F decodes again)")
                t.skipped += 1
                continue
            session = session or OtrSession(s)
            written, check = decode_file(session, path, outdir)
            OUT.msg(f" >>> decoded {written.name} [{check}]")
            t.decoded += 1
        except OtrError as e:
            OUT.error(f"ERROR {e.code} [1]: {e.text}")
            t.failed.append(path.name)


def cmd_decode(s: Settings, args: Sequence[str], force: bool) -> int:
    """decode <FILE>.. [<DIR>]: a last argument that is a directory is where it writes."""
    items = list(args)
    if items == ["-"]:
        phase("reading the names on stdin")
        items = [ln.strip() for ln in sys.stdin.read().splitlines() if ln.strip()]
    if len(items) > 1 and Path(items[-1]).is_dir():
        outdir = Path(items.pop())
    elif s.decode_dir:
        outdir = Path(s.decode_dir).expanduser()
        OUT.msg(f" >>> writing into {outdir} (DEFAULT_DECODE_OUTP_DIR)")
        outdir.mkdir(parents=True, exist_ok=True)
    else:
        err("00063", "decode: no <DIR> given, and DEFAULT_DECODE_OUTP_DIR is not set")
    if not items:
        err("00064", "decode: no file given")
    t = Tally(read=len(items))
    decode_all(s, [Path(i) for i in items], outdir, force, t)
    if t.failed:
        err("00065", f"{len(t.failed)} of {t.read} failed: " + ", ".join(t.failed))
    return 0



# --- 7. programmed recordings: record, list, refresh, the nightly job -------

RECORDINGS_HEAD: Final = """\
## my-otr's programmed recordings -- one `record` line each. my-otr READS
## this file, it never runs it; `my-otr record ...` adds a line, an editor
## is as good. `my-otr list` shows them, `my-otr refresh` fetches them.
##
## record <FOLDER> <TITLE> [<FILTER>..] [--max <N>]
##   <FOLDER>  where the recordings go: absolute, or below LIBRARY_DIR; made when missing
##   <TITLE> <FILTER>..   what `my-otr search` takes: @channel, a weekday, a
##             time, a duration, and the dates: '>1d' (since a day ago: a
##             recurring one), @2026-11-03 (that day), '>2026-11-01' '<2026-11-07'
##   --max <N> fetch at most N new ones per refresh (default: all)
## e.g. -- a show, every day it is on:
##   record series.de/bares.fuer.rares/s0x/ 'bares fuer rares' @zdf '>1d' @15:05
## a weekly show, at most 2 a run:
##   record series.de/heute.show/s0x/ 'heute show' @zdf '>7d' '>18h' '<23h' --max 2
## one evening:
##   record /Volumes/films/ tatort @ard @2026-11-03 @20:15 --max 1
## a week:
##   record sport/ olympia @zdf '>2026-11-01' '<2026-11-07'
"""


@dataclass(frozen=True)
class Programmed:
    """One `record` line: where the recordings go, the search, how many."""

    where: str                      # "<file>:<line>", or "the command line"
    folder_text: str                # as written
    folder: Path
    words: Tuple[str, ...]          # the search's own words: title and filters
    max: Optional[int]
    last_day: Optional[datetime.date]

    @property
    def search(self) -> str:
        return shlex.join(self.words)

    def line(self) -> str:
        return shlex.join(["record", self.folder_text, *self.words,
                           *(["--max", str(self.max)] if self.max is not None else [])])

    def outdated(self, s: Settings, today: datetime.date) -> bool:
        """A one-off whose last day is more than PAST_AFTER_DAYS ago (#47)."""
        return self.last_day is not None and (today - self.last_day).days > s.past_after_days


def parse_record(s: Settings, words: Sequence[str], where: str) -> Programmed:
    """The words after `record`, checked once: --max, the folder, the search."""
    rest: List[str] = []
    most: Optional[int] = None
    it = iter(words)
    for w in it:
        key, eq, val = w.partition("=")
        if key == "--max":
            v = val if eq else next(it, "")
            if not re.fullmatch(r"[1-9]\d*", v):
                err("00066", f"{where}: --max '{v}' -- a number, 1 or more")
            most = int(v)
        else:
            rest.append(w)
    if len(rest) < 2:
        err("00067", f"{where}: record <FOLDER> <TITLE> [<FILTER>..] [--max <N>] -- {shlex.join(words)[:80]}")
    folder_text, search = rest[0], tuple(rest[1:])
    if folder_text.startswith("/"):
        folder = Path(folder_text)
    elif s.library_dir:
        folder = Path(s.library_dir).expanduser() / folder_text
    else:
        err("00068", f"{where}: '{folder_text}' is relative, and LIBRARY_DIR is not set -- an absolute folder, or set it")
    try:
        filters = parse_filters(search)
    except OtrError as e:
        raise OtrError(e.code, f"{where}: {e.text}") from e
    return Programmed(where, folder_text, folder, search, most, filters.day_till)


def read_recordings(s: Settings) -> List[Programmed]:
    """RECORDINGS_FILE, parsed and never run; no file is no recordings."""
    try:
        text = s.recordings_file.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []
    except OSError as e:
        err("00069", f"cannot read RECORDINGS_FILE {s.recordings_file}: {e.strerror}")
    found: List[Programmed] = []
    for n, raw in enumerate(text.splitlines(), 1):
        where = f"{s.recordings_file}:{n}"
        try:
            words = shlex.split(raw, comments=True)
        except ValueError as e:
            err("00070", f"{where}: {e}")
        if not words:
            continue
        if words[0] != "record":
            err("00071", f"{where}: not a `record` line -- {raw.strip()[:80]}")
        found.append(parse_record(s, words[1:], where))
    return found


@contextlib.contextmanager
def recordings_lock(s: Settings) -> Generator[None, None, None]:
    """One refresh or record at a time: an atomic mkdir beside the recordings,
    its owner's pid inside; a dead owner's lock is broken, and said."""
    lock = s.recordings_file.with_name(s.recordings_file.name + ".lock")
    while True:
        try:
            lock.mkdir()
            break
        except FileExistsError:
            try:
                owner = (lock / "owner").read_text(encoding="utf-8").strip()
            except OSError:
                owner = ""
            m = re.match(r"pid=(\d+)", owner)
            if m is None or _alive(int(m.group(1))):
                err("00072", f"another my-otr is refreshing or recording ({owner or 'owner not yet written'}): "
                             f"{lock} -- run again when it is done")
            OUT.msg(f" >>> breaking a stale lock: its owner is gone ({owner})")
            with contextlib.suppress(OSError):
                (lock / "owner").unlink()
            with contextlib.suppress(OSError):
                lock.rmdir()
    try:
        (lock / "owner").write_text(f"pid={os.getpid()} at={datetime.datetime.now():%Y-%m-%d %H:%M:%S}\n",
                                    encoding="utf-8")
        yield
    finally:
        with contextlib.suppress(OSError):
            (lock / "owner").unlink()
        with contextlib.suppress(OSError):
            lock.rmdir()


_child: List[str] = [sys.executable, os.path.realpath(__file__)]    # how a search or get is run (#44)


def child_options(s: Settings) -> List[str]:
    """What a child my-otr is given: this run's config, log, quiet and debug."""
    opts = ["--config", str(s.files[-1])] if s.files else []
    opts += ["--log-file", OUT.log.name] if OUT.log is not None else ["-L"]
    return opts + (["-Q"] if OUT.quiet else []) + (["-D"] if OUT.dbg_on else [])


def run_child(argv: Sequence[str], timeout: int, folder: Path, stdin: str = "",
              capture: bool = False) -> Optional[Tuple[int, str]]:
    """One child, in a session of its own so that a timeout kills it with all
    it started (aria2c too); None when it was killed for the time."""
    OUT.dbg(f"child: {shlex.join(argv)}  (in {folder}, {timeout}s)")
    p = subprocess.Popen(list(argv), cwd=folder, stdin=subprocess.PIPE, text=True, start_new_session=True,
                         stdout=subprocess.PIPE if capture else None)
    try:
        out, _ = p.communicate(stdin, timeout=timeout or None)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        return None
    except BaseException:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(p.pid, signal.SIGKILL)
        raise
    return p.returncode, out or ""


def found_now(s: Settings, rec: Programmed) -> Optional[Tuple[int, List[str]]]:
    """The search of one recording, as a child; (rc, names) or None on a timeout."""
    res = run_child([*_child, *child_options(s), "search", *rec.words], s.search_timeout,
                    rec.folder if rec.folder.is_dir() else Path.home(), capture=True)
    if res is None:
        return None
    return res[0], [ln.strip() for ln in res[1].splitlines() if ln.strip()]


def mail_failure(s: Settings, text: str) -> None:
    """A run nobody watches mails its failure; one on a terminal does not."""
    if sys.stderr.isatty() or not s.fail_mail_cmd:
        return
    host = socket.gethostname().split(".")[0]
    body = f"{text}\n\nhost: {host}\nlog:  {OUT.log.name if OUT.log is not None else 'none'}"
    if OUT.log is not None:
        with contextlib.suppress(OSError):
            body += "\n\nend of the log:\n" + "\n".join(Path(OUT.log.name).read_text(encoding="utf-8").splitlines()[-40:])
    try:
        rc = subprocess.run([*s.fail_mail_cmd, f"{SCRIPT_NAME} refresh FAILED on {host}", body],
                            stdin=subprocess.DEVNULL).returncode
    except OSError as e:
        rc = -1
        OUT.warn(f"FAIL_MAIL_CMD: {e.strerror or e}")
    if rc != 0:
        OUT.warn(f"FAIL_MAIL_CMD failed [rc {rc}] -- the failure mail was NOT sent")


def cmd_test_mail(s: Settings) -> int:
    if not s.fail_mail_cmd:
        err("00073", "--test-mail: FAIL_MAIL_CMD is not set -- no failure mail would go out")
    host = socket.gethostname().split(".")[0]
    rc = subprocess.run([*s.fail_mail_cmd, f"{SCRIPT_NAME}: test mail from {host}",
                         f"Test mail: a failed {SCRIPT_NAME} refresh is mailed through this same path.\n\n"
                         f"host:   {host}\nuser:   {getpass.getuser()}\ntime:   {datetime.datetime.now():%Y-%m-%d %H:%M:%S}\n"
                         f"config: {' + '.join(str(p) for p in s.files) or 'none'}\nsent:   {shlex.join(s.fail_mail_cmd)}"],
                        stdin=subprocess.DEVNULL).returncode
    if rc != 0:
        err("00074", f"--test-mail: test mail NOT sent [rc {rc}]: {shlex.join(s.fail_mail_cmd)}")
    OUT.msg(f" >>> test mail sent through {shlex.join(s.fail_mail_cmd)} [rc 0]")
    return 0


def cmd_refresh(s: Settings, args: Sequence[str]) -> int:
    """Each programmed recording: search, then get the new ones into its
    folder. One failing never stops the others; the run fails at the end."""
    dry = "--dry-run" in args
    texts = [a for a in args if a != "--dry-run"]
    if len(texts) > 1:
        err("00075", "refresh [<TEXT>] [--dry-run] -- one TEXT at most (a part of the `record` line)")
    text = texts[0] if texts else None
    recs = read_recordings(s)
    if not recs:
        err("00076", f"no recordings in {s.recordings_file} -- `{SCRIPT_NAME} record ...` adds one")
    chosen = [r for r in recs if text is None or text in r.line()]
    if not chosen:
        err("00077", f"no recording holds '{text}' -- `{SCRIPT_NAME} list` shows them")
    with recordings_lock(s):
        today = datetime.date.today()
        failures: List[str] = []
        searched = failed_searches = done = 0
        for rec in chosen:
            if rec.outdated(s, today):
                OUT.warn(f"outdated line (last day {rec.last_day}): {rec.search} -- please check/remove ({rec.where})")
                continue
            if done and s.sleep_seconds:
                phase(f"pausing before {rec.search}")
                OUT.det(f"    > pausing {s.sleep_seconds}s, so the OTR API is not hit too fast")
                time.sleep(s.sleep_seconds)
            done += 1
            phase(f"refreshing {rec.search}")
            searched += 1
            found = found_now(s, rec)
            if found is None or found[0] != 0:
                failed_searches += 1
                why = (f"the search gave no answer within SEARCH_TIMEOUT={s.search_timeout}s -- killed"
                       if found is None else f"the search failed [rc {found[0]}]")
                failures.append(f"  {rec.search}: {why}")
                OUT.warn(f"{rec.search}: {why}")
                continue
            names = found[1][:rec.max] if rec.max else found[1]
            of = f"{len(found[1])} found" + (f", max {rec.max}" if rec.max else "")
            if not names:
                OUT.msg(f" >>> {rec.search}: nothing new [{of}]")
                continue
            if dry:
                OUT.msg(f" >>> {rec.search}: would fetch {len(names)} [{of}, --dry-run]")
                for n in names:
                    OUT.msg(f"    > {n}")
                continue
            try:
                rec.folder.mkdir(parents=True, exist_ok=True)
            except OSError as e:
                failures.append(f"  {rec.search}: cannot make {rec.folder}: {e.strerror}")
                continue
            got = run_child([*_child, *child_options(s), "get"], s.get_timeout, rec.folder, "\n".join(names) + "\n")
            if got is None or got[0] != 0:
                why = (f"the get was not done within GET_TIMEOUT={s.get_timeout}s -- killed"
                       if got is None else f"the get failed [rc {got[0]}]")
                failures.append(f"  {rec.search}: {why} on {len(names)} recording(s)")
                OUT.warn(f"{rec.search}: {why}")
                continue
            OUT.msg(f" >>> {rec.search}: fetched {len(names)} [{of}, rc 0]")
        if text is None and not dry and s.run_after_refresh:
            phase("running RUN_AFTER_REFRESH")
            try:
                rc = subprocess.run(list(s.run_after_refresh), stdin=subprocess.DEVNULL).returncode
            except OSError as e:
                rc = -1
                OUT.warn(f"RUN_AFTER_REFRESH: {e.strerror or e}")
            OUT.msg(f" >>> RUN_AFTER_REFRESH: {shlex.join(s.run_after_refresh)} [rc {rc}]")
            if rc != 0:
                failures.append(f"  RUN_AFTER_REFRESH {shlex.join(s.run_after_refresh)} failed [rc {rc}]")
        phase("finishing")
        OUT.msg(f" >>> refresh: done [{done} recording(s), {len(failures)} failed]")
        if failures:
            head = (f"\n  EVERY search failed ({failed_searches} of {searched}): OTR was out of reach for this run -- "
                    f"the network, or a firewall prompt nobody answered"
                    if searched > 1 and failed_searches == searched else "")
            text_ = f"{len(failures)} of {done} recording(s) failed:{head}\n" + "\n".join(failures)
            mail_failure(s, text_)
            err("00078", text_)
    return 0


def cmd_record(s: Settings, args: Sequence[str]) -> int:
    """Add a recording: check the line, search once, then append it (#50)."""
    rec = parse_record(s, args, "the command line")
    line = rec.line()
    with recordings_lock(s):
        if any(r.line() == line for r in read_recordings(s)):
            OUT.msg(f" >>> already programmed: {line}")
            return 0
        found = found_now(s, rec)
        if found is None:
            OUT.warn(f"the search gave no answer within SEARCH_TIMEOUT={s.search_timeout}s -- recorded anyway")
        elif found[0] != 0:
            err("00079", f"the search failed [rc {found[0]}] -- nothing recorded: {rec.search}")
        elif found[1]:
            OUT.msg(f" >>> found {len(found[1])} now:")
            for n in found[1]:
                OUT.msg(f"    > {n}")
        else:
            OUT.msg(" >>> nothing found yet")
        f = s.recordings_file
        try:
            old = f.read_text(encoding="utf-8")
        except FileNotFoundError:
            old = RECORDINGS_HEAD
        new = f.with_name(f".{f.name}.{os.getpid()}.new")
        try:
            new.write_text(old + ("" if old.endswith("\n") or not old else "\n") + line + "\n", encoding="utf-8")
            os.replace(new, f)
        finally:
            with contextlib.suppress(OSError):
                new.unlink()
    OUT.msg(f" >>> recorded: {line}  [{f}]")
    return 0


def cmd_list(s: Settings) -> int:
    recs = read_recordings(s)
    today = datetime.date.today()
    for r in recs:
        OUT.result(r.line() + ("   outdated -- please check/remove" if r.outdated(s, today) else ""))
    old = sum(1 for r in recs if r.outdated(s, today))
    OUT.msg(f" >>> {len(recs)} recording(s) in {s.recordings_file}" + (f", {old} outdated" if old else ""))
    return 0


def last_refresh(s: Settings) -> str:
    """The last `refresh: done` line of the LOGFILE -- read, nothing queried."""
    try:
        with open(Path(s.logfile).expanduser(), "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 512 * 1024))
            tail = f.read().decode("utf-8", "replace")
    except OSError:
        return "none in the log"
    hits = [ln for ln in tail.splitlines() if "refresh: done [" in ln]
    if not hits:
        return "none in the log"
    m = re.match(r"(\S+ \S+) \[\d+\] .*refresh: done \[(.*)\]", hits[-1])
    return f"{m.group(1)}, {m.group(2)}" if m else hits[-1]


def plist_path(s: Settings) -> Path:
    return Path("/Library/LaunchDaemons") / f"{s.launchd_label}.plist"


def cmd_state(argv: Sequence[str], config: Optional[str]) -> int:
    """Bare my-otr: a short usage line and where things stand (#48)."""
    OUT.result(f"usage: {SCRIPT_NAME} [OPTIONS] <COMMAND> [<ARGS>]   ({SCRIPT_NAME} --help: all of it)")
    try:
        s = load_settings(config)
    except OtrError as e:
        OUT.result(f" >>> config: none usable -- {e.text}")
        return 1
    recs = read_recordings(s)
    today = datetime.date.today()
    one_off = sum(1 for r in recs if r.last_day is not None)
    old = sum(1 for r in recs if r.outdated(s, today))
    OUT.result(f" >>> config: {' + '.join(str(p) for p in s.files) or 'none (the built-in defaults)'}")
    OUT.result(f" >>> recordings: {len(recs)} in {s.recordings_file} ({len(recs) - one_off} recurring, {one_off} one-off)"
               + (f", {old} outdated" if old else "") + f" -- '{SCRIPT_NAME} list'")
    p = plist_path(s)
    how = f"through {s.fda_launcher}" if s.fda_launcher else "my-otr itself"
    OUT.result(f" >>> nightly: installed, {s.run_at} as {s.run_as or '?'}, {how} [{p}]" if p.exists()
               else f" >>> nightly: not installed ('{SCRIPT_NAME} --install', root)")
    OUT.result(f" >>> last run: {last_refresh(s)}")
    return 0


def plist_content(s: Settings, program: str) -> str:
    """The LaunchDaemon. With a launcher it runs as root and drops to its own
    user; without one, launchd runs my-otr as RUN_AS. Both outputs go into
    LAUNCHD_LOG -- without a path launchd throws them away."""
    home = pwd.getpwnam(s.run_as).pw_dir if not s.fda_launcher else ""
    first = s.fda_launcher or program
    h, m = (int(x) for x in s.run_at.split(":"))
    user = f"\n\t<key>UserName</key>          <string>{s.run_as}</string>" if not s.fda_launcher else ""
    env = f"\n\t\t<key>HOME</key> <string>{home}</string>" if home else ""
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
\t<key>Label</key>             <string>{s.launchd_label}</string>
\t<key>ProgramArguments</key>
\t<array>
\t\t<string>{first}</string>
\t\t<string>-Q</string>
\t\t<string>refresh</string>
\t</array>{user}
\t<key>EnvironmentVariables</key>
\t<dict>
\t\t<key>PATH</key> <string>{s.launchd_path}</string>{env}
\t</dict>
\t<key>StartCalendarInterval</key>
\t<dict>
\t\t<key>Hour</key>   <integer>{h}</integer>
\t\t<key>Minute</key> <integer>{m}</integer>
\t</dict>
\t<key>StandardOutPath</key>   <string>{s.launchd_log}</string>
\t<key>StandardErrorPath</key> <string>{s.launchd_log}</string>
</dict>
</plist>
"""


_geteuid: Callable[[], int] = os.geteuid


def check_install(s: Settings) -> None:
    """What --install refuses, before root is even asked for."""
    if not re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", s.run_at):
        err("00080", f"RUN_AT=\"{s.run_at}\" -- HH:MM")
    if s.run_at.startswith("02:"):
        err("00081", f"RUN_AT=\"{s.run_at}\": launchd fires a time between 02:00 and 02:59 twice on the night "
                     "the clocks go back -- choose one outside it")
    if not s.run_as:
        err("00082", "RUN_AS is not set -- who does the nightly refresh run as?")
    try:
        pwd.getpwnam(s.run_as)
    except KeyError:
        err("00083", f"RUN_AS=\"{s.run_as}\": no such user here")
    if s.fda_launcher and not os.access(s.fda_launcher, os.X_OK):
        err("00084", f"FDA_LAUNCHER \"{s.fda_launcher}\" is not there, or not executable")


def cmd_install(s: Settings, remove: bool) -> int:
    p = plist_path(s)
    if not remove:
        check_install(s)
    if _geteuid() != 0:
        err("00085", f"needs root -- as root: {SCRIPT_NAME} --{'uninstall' if remove else 'install'}")
    target = f"system/{s.launchd_label}"
    if remove:
        if not p.exists():
            err("00086", f"--uninstall: {p} is not there -- nothing installed")
        subprocess.run(["launchctl", "bootout", target], stdin=subprocess.DEVNULL)
        p.unlink()
        OUT.msg(f" >>> removed {p} (and the job from launchd)")
        return 0
    program = os.path.abspath(sys.argv[0])
    new = p.with_name(f".{p.name}.{os.getpid()}.new")
    try:
        new.write_text(plist_content(s, program), encoding="utf-8")
        if subprocess.run(["plutil", "-lint", "-s", str(new)]).returncode != 0:
            err("00087", "--install: the plist written does not lint -- nothing installed")
        os.chmod(new, 0o644)
        with contextlib.suppress(OSError):
            Path(s.launchd_log).parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["launchctl", "bootout", target], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.replace(new, p)
    finally:
        with contextlib.suppress(OSError):
            new.unlink()
    if subprocess.run(["launchctl", "bootstrap", "system", str(p)]).returncode != 0:
        err("00088", f"--install: launchctl bootstrap failed for {p}")
    how = f"through {s.fda_launcher} (it drops to its own user)" if s.fda_launcher else f"as {s.run_as}"
    OUT.msg(f" >>> installed {p}: `{SCRIPT_NAME} -Q refresh` daily at {s.run_at}, {how}; its output: {s.launchd_log}")
    return 0


def version_line() -> str:
    """The exact build: the version; git's describe where this file is tracked
    in its OWN repository (else the stamped commit); the hash of the bytes."""
    me = Path(os.path.realpath(__file__))
    build = hashlib.sha256(me.read_bytes()).hexdigest()[:12]
    desc = SCRIPT_COMMIT

    def git(*a: str) -> str:
        r = subprocess.run(["git", "-C", str(me.parent), *a], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""

    try:
        if git("remote", "get-url", "origin").endswith((REPOSITORY, REPOSITORY + ".git")) \
                and git("ls-files", me.name) == me.name:
            desc = git("describe", "--tags", "--long", "--always", "--dirty") or desc
    except (OSError, subprocess.SubprocessError):
        pass
    return f"{SCRIPT_NAME} {SCRIPT_VERSION} ({desc}, build {build})"


