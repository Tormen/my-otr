def _swap32(b: bytes) -> bytes:
    """Every 4-byte word reversed: OTR's Blowfish loads its blocks little-endian."""
    a = array.array("I")
    assert a.itemsize == 4, "array 'I' must be 32 bits here"
    a.frombytes(b)
    a.byteswap()
    return a.tobytes()


class OtrBlowfish:
    """Blowfish-ECB as OTR's .otrkey uses it: the standard cipher on byte-swapped words."""

    def __init__(self, key: bytes) -> None:
        from cryptography.hazmat.decrepit.ciphers.algorithms import Blowfish
        from cryptography.hazmat.primitives.ciphers import Cipher, modes
        self._cipher = Cipher(Blowfish(key), modes.ECB())
        self._dec = self._cipher.decryptor()

    def decrypt(self, data: bytes) -> bytes:
        return _swap32(self._dec.update(_swap32(data)))

    def encrypt(self, data: bytes) -> bytes:
        """The way back -- for --run-tests."""
        return _swap32(self._cipher.encryptor().update(_swap32(data)))


@dataclass(frozen=True)
class Otr2Header:
    rec: str
    nonce: bytes
    size: int
    content_type: str
    body_offset: int


def read_otr2_header(path: Path) -> Otr2Header:
    with path.open("rb") as f:
        pre = f.read(OTR2_PREAMBLE)
        if len(pre) < OTR2_PREAMBLE or pre[:8] != OTR2_MAGIC:
            err("00037", f"{path.name}: not an .otr2 file ({len(pre)} bytes of preamble) -- a broken download?")
        version, hlen = int.from_bytes(pre[8:10], "little"), int.from_bytes(pre[12:16], "little")
        if version != 1 or not 0 < hlen <= 64 * 1024:
            err("00038", f"{path.name}: .otr2 version {version}, header {hlen} bytes -- not one my-otr knows")
        try:
            raw: object = json.loads(f.read(hlen))
        except ValueError:
            err("00039", f"{path.name}: the .otr2 header is no JSON")
    if not isinstance(raw, dict):
        err("00040", f"{path.name}: the .otr2 header is no JSON object")
    h = cast(Dict[str, object], raw)
    scheme, iv, size, ctype = h.get("scheme", OTR2_SCHEME), h.get("iv"), h.get("size", 0), h.get("content_type")
    if scheme != OTR2_SCHEME or not isinstance(iv, str) or not isinstance(size, int):
        err("00041", f"{path.name}: .otr2 scheme {scheme!r} -- my-otr knows {OTR2_SCHEME}")
    try:
        nonce = bytes.fromhex(iv)
    except ValueError:
        nonce = b""
    if len(nonce) != 12:
        err("00042", f"{path.name}: the .otr2 IV is not 12 bytes")
    raw_end = OTR2_PREAMBLE + hlen
    return Otr2Header(field_str(h, "rec", path.name), nonce, size,
                      ctype if isinstance(ctype, str) else "video/mp4", raw_end + (-raw_end) % OTR2_ALIGN)


def _otr_reason(r: Reply) -> str:
    try:
        data: object = json.loads(r.body)
    except ValueError:
        return r.text()[:160]
    if isinstance(data, dict):
        obj = cast(Dict[str, object], data)
        return str(obj.get("message") or obj.get("error") or obj)[:160]
    return str(data)[:160]


class OtrSession:
    """The OTR account's keys: one login, one ticket and one key pair per run,
    shared by every file it decodes. The private key never leaves this process."""

    def __init__(self, s: Settings) -> None:
        from cryptography.hazmat.primitives.asymmetric import ec
        self._s = s
        self._jwt: Optional[str] = None
        self._ticket: Optional[str] = None
        self._ticket_exp = 0.0
        self._priv = ec.generate_private_key(ec.SECP256R1())

    def _ticket_now(self) -> str:
        if self._jwt is None:
            phase("logging in to onlinetvrecorder.com")
            r = fetch("POST", f"{OTR_API}/api/auth/login",
                      json_body={"email": self._s.secret("OTR_LOGIN"), "password": self._s.secret("OTR_PASSW")})
            if r.status == 401:
                err("00043", "onlinetvrecorder.com refused the login -- check OTR_LOGIN / OTR_PASSW")
            if r.status >= 400:
                err("00044", f"onlinetvrecorder.com login: HTTP {r.status}: {_otr_reason(r)}")
            self._jwt = field_str(r.obj("the OTR login"), "token", "the OTR login")
        if self._ticket is None or time.time() > self._ticket_exp - 30:
            r = fetch("GET", f"{OTR_API}/api/otr2/ticket", headers={"Authorization": f"Bearer {self._jwt}"})
            if r.status >= 400:
                err("00045", f"onlinetvrecorder.com ticket: HTTP {r.status}: {_otr_reason(r)}")
            obj = r.obj("the OTR ticket")
            exp = obj.get("exp")
            self._ticket = field_str(obj, "ticket", "the OTR ticket")
            self._ticket_exp = float(exp) if isinstance(exp, (int, float)) else time.time() + 3000
        return self._ticket

    def otr2_key(self, rec: str) -> Tuple[bytes, Optional[str]]:
        """The content key of recording `rec`, and the plaintext's sha256 when OTR has one."""
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        from cryptography.hazmat.primitives.kdf.hkdf import HKDF
        pub = base64.b64encode(self._priv.public_key().public_bytes(
            serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo)).decode()
        r = fetch("POST", f"{OTR_KEYS}/key", json_body={"rec": rec, "token": self._ticket_now(), "client_pub": pub})
        if r.status == 403:
            err("00046", f"onlinetvrecorder.com: no right to recording {rec}: {_otr_reason(r)}")
        if r.status == 404:
            err("00047", f"onlinetvrecorder.com: recording {rec} is not on the key server")
        if r.status >= 400:
            err("00048", f"onlinetvrecorder.com key: HTTP {r.status}: {_otr_reason(r)}")
        obj = r.obj("the OTR key")
        try:
            # ECIES: the server's ephemeral P-256 point (65) | nonce (12) | AES-GCM of the key
            wrapped = base64.b64decode(field_str(obj, "wrapped_cek", "the OTR key"), validate=True)
            eph = ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), wrapped[:65])
            kek = HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=ECIES_INFO.encode()).derive(
                self._priv.exchange(ec.ECDH(), eph))
            cek = AESGCM(kek).decrypt(wrapped[65:77], wrapped[77:], None)
        except (ValueError, TypeError) as e:
            err("00049", f"onlinetvrecorder.com: the key of {rec} cannot be unwrapped ({type(e).__name__})")
        sha = obj.get("plaintext_sha256")
        return cek, (sha.lower() if isinstance(sha, str) and sha else None)

    def otrkey_key(self, fn: str, oh: str) -> bytes:
        r = fetch("POST", OTR_QUELLE, form=[("email", self._s.secret("OTR_LOGIN")),
                                            ("password", self._s.secret("OTR_PASSW")), ("FN", fn), ("OH", oh)])
        obj = r.obj("the .otrkey key service")
        if "error" in obj:
            err("00050", f"onlinetvrecorder.com refused the key of {fn}: {obj.get('message') or obj['error']}")
        try:
            return bytes.fromhex(field_str(obj, "random_key", "the .otrkey key service"))
        except ValueError:
            err("00051", f"onlinetvrecorder.com: the key of {fn} is no hex string")


def otrkey_fields(path: Path) -> Dict[str, str]:
    """The .otrkey header: "FN=...&OH=..." under OTR's fixed header key."""
    with path.open("rb") as f:
        head = f.read(len(OTRKEY_MAGIC) + OTRKEY_HEADER)
    if len(head) < len(OTRKEY_MAGIC) + OTRKEY_HEADER or not head.startswith(OTRKEY_MAGIC):
        err("00052", f"{path.name}: not an .otrkey file -- a broken download?")
    text = OtrBlowfish(OTRKEY_HEADER_KEY).decrypt(head[len(OTRKEY_MAGIC):]).split(b"\0", 1)[0]
    return dict(p.split("=", 1) for p in text.decode("latin-1").split("&") if "=" in p)


def decoded_name(path: Path) -> str:
    """#16: OTR's name with the container's extension (`..._TVOON_DE.HQ.mp4`);
    an .otrkey's name without its last suffix (`..._TVOON_DE.mpg.HQ.avi`)."""
    if path.suffix.lower() == ".otrkey":
        return path.stem
    ext = CONTAINER_EXT.get(read_otr2_header(path).content_type, ".mp4")
    return path.stem if path.stem.lower().endswith(ext) else path.stem + ext


def decode_file(session: OtrSession, path: Path, outdir: Path) -> Tuple[Path, str]:
    """Decode one .otr2 / .otrkey into `outdir`, written beside as .part and
    renamed when complete; the source is removed then -- an .otr2 only when it
    matches OTR's checksum, where OTR sent one. Returns the file and that check."""
    phase(f"decoding {path.name}")
    out = outdir / decoded_name(path)
    part = out.with_name(out.name + ".my-otr.part")
    try:
        check = (_decode_otr2 if path.suffix.lower() == ".otr2" else _decode_otrkey)(session, path, part)
        part.replace(out)
    finally:
        if part.exists():
            part.unlink()
    path.unlink()
    return out, check


def _decode_otr2(session: OtrSession, path: Path, part: Path) -> str:
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    h = read_otr2_header(path)
    have, want = path.stat().st_size, h.body_offset + h.size
    if h.size and have < want:
        # before the key is asked for: every key OTR hands out counts as a decode
        err("00053", f"{path.name}: incomplete download ({have} of {want} bytes) -- no key asked for")
    cek, sha_want = session.otr2_key(h.rec)
    dec = Cipher(algorithms.AES(cek), modes.CTR(h.nonce + b"\0\0\0\0")).decryptor()
    sha, done = hashlib.sha256(), 0
    with path.open("rb") as src, part.open("wb") as dst:
        src.seek(h.body_offset)
        while True:
            chunk = src.read(min(CHUNK, h.size - done) if h.size else CHUNK)
            if not chunk:
                break
            plain = dec.update(chunk)
            sha.update(plain)
            dst.write(plain)
            done += len(plain)
        dst.flush()
        os.fsync(dst.fileno())
    if h.size and done != h.size:
        err("00054", f"{path.name}: {done} of {h.size} bytes decoded")
    if sha_want is None:
        return f"{done} bytes, OTR sent no checksum"
    if sha.hexdigest() != sha_want:
        err("00055", f"{path.name}: the decoded content differs from the recording "
                     f"(sha256 {sha.hexdigest()[:12]} != OTR's {sha_want[:12]}) -- the source is kept")
    return f"sha256 {sha_want[:12]} = OTR's"


def _decode_otrkey(session: OtrSession, path: Path, part: Path) -> str:
    fields = otrkey_fields(path)
    if not fields.get("OH"):
        err("00056", f"{path.name}: the .otrkey header has no OH")
    bf = OtrBlowfish(session.otrkey_key(fields.get("FN", path.name), fields["OH"]))
    done = 0
    with path.open("rb") as src, part.open("wb") as dst:
        src.seek(len(OTRKEY_MAGIC) + OTRKEY_HEADER)
        while True:
            chunk = src.read(CHUNK)
            if not chunk:
                break
            whole = len(chunk) - len(chunk) % 8
            dst.write(bf.decrypt(chunk[:whole]) + chunk[whole:])   # a tail under 8 bytes is plain
            done += len(chunk)
        dst.flush()
        os.fsync(dst.fileno())
    return f"{done} bytes"


def update_check(zip_path: Path) -> int:
    """What a new release of OTR's decoder changed against the reviewed one."""
    try:
        with zipfile.ZipFile(zip_path) as z:
            files = {Path(n).name: z.read(n) for n in z.namelist() if n.endswith(".py")}
    except (OSError, zipfile.BadZipFile) as e:
        err("00057", f"{zip_path}: not a readable zip ({e})")
    source = b"\n".join(files.values()).decode("utf-8", "replace")
    m = re.search(r"__version__ = '([^']+)'", source)
    OUT.result(f" >>> OTR's decoder {m.group(1) if m else '(no __version__)'}, against the reviewed {REFERENCE_RELEASE}:")
    changed = 0
    for name, sha in REFERENCE_FILES.items():
        got = hashlib.sha256(files[name]).hexdigest() if name in files else None
        if got != sha:
            changed += 1
            OUT.result(f"    > {name}: {'GONE' if got is None else 'changed'} -- review it"
                       + ("  (the watermark: my-otr adds none, #15)" if name == "otr2_watermark.py" else ""))
    for what, literal in PROTOCOL.items():
        if literal not in source:
            changed += 1
            OUT.result(f"    > {what}: CHANGED -- '{literal}' is no longer in it")
    OUT.result(f" >>> {changed} thing(s) to review" if changed else " >>> the same protocol -- nothing to do")
    return 0


