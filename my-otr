def config_search_paths() -> List[Path]:
    """Where the config is looked for, in order (after $MY_OTR_CONFIG and --config)."""
    site = Path(os.environ.get("LINKS", "/LINKS")) / "default"
    return [site / f"{SCRIPT_NAME}.conf", site / SCRIPT_NAME, Path.home() / f".{SCRIPT_NAME}.conf",
            Path("/etc") / f"{SCRIPT_NAME}.conf", Path("/usr/local/etc") / f"{SCRIPT_NAME}.conf"]


def config_offer() -> List[str]:
    """Where to write a config, most common place first -- a FILTER of the
    search list, so it never names a place that is not read."""
    searched = config_search_paths()
    return [str(p) for p in (Path("/etc") / f"{SCRIPT_NAME}.conf", Path.home() / f".{SCRIPT_NAME}.conf")
            if p in searched]


_KEY_LINE: Final = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
_NAME_REF: Final = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z0-9_]*)\}|([A-Za-z_][A-Za-z0-9_]*))")


def _expand(text: str, names: Dict[str, str], where: str) -> str:
    if "$(" in text or "`" in text:
        err("00003", f"{where}: a command substitution -- my-otr reads its config, it never runs it")

    def one(m: re.Match[str]) -> str:
        name = m.group(1) or m.group(2)
        if name in names:
            return names[name]
        if name in os.environ:
            return os.environ[name]
        if name == "USER":
            return getpass.getuser()
        if name == "HOME":
            return str(Path.home())
        err("00004", f"{where}: ${name} is not set (a key above, or the environment)")

    return _NAME_REF.sub(one, text)


def parse_value(raw: str, names: Dict[str, str], where: str) -> str:
    """One shell word: unquoted, "double" ($ expanded) and 'single' parts, a
    leading ~ as $HOME, then nothing but a # comment."""
    out: List[str] = []
    i = 0
    while i < len(raw):
        c = raw[i]
        if c == "'":
            j = raw.find("'", i + 1)
            if j < 0:
                err("00005", f"{where}: a ' is not closed")
            out.append(raw[i + 1:j])
            i = j + 1
        elif c == '"':
            j = i + 1
            part: List[str] = []
            while j < len(raw) and raw[j] != '"':
                if raw[j] == "\\" and j + 1 < len(raw) and raw[j + 1] in '"\\$`':
                    j += 1
                part.append(raw[j])
                j += 1
            if j >= len(raw):
                err("00006", f"{where}: a \" is not closed")
            out.append(_expand("".join(part), names, where))
            i = j + 1
        elif c in " \t":
            rest = raw[i:].strip()
            if rest and not rest.startswith("#"):
                err("00007", f"{where}: more than one word -- quote the value")
            break
        else:
            m = re.match(r"[^'\" \t]+", raw[i:])
            assert m is not None, "c is none of the characters the word stops at"
            word = m.group(0)
            i += len(word)
            if not out and (word == "~" or word.startswith("~/")):
                word = str(Path.home()) + word[1:]
            out.append(_expand(word, names, where))
    return "".join(out)


def read_config_text(text: str, where: str, names: Dict[str, str]) -> List[str]:
    """Add the KEY=value lines of `text` to `names`; return the keys it set."""
    keys: List[str] = []
    for n, line in enumerate(text.splitlines(), 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = _KEY_LINE.match(s)
        if m is None:
            err("00008", f"{where}:{n}: not a KEY=\"value\" line -- my-otr reads its config, it never runs it: {s[:60]}")
        names[m.group(1)] = parse_value(m.group(2), names, f"{where}:{n}")
        keys.append(m.group(1))
    return keys


def _flag(value: str, key: str, where: str) -> bool:
    if value in ("", "0"):
        return False
    if value == "1":
        return True
    err("00009", f"{where}: {key}=\"{value}\" -- \"1\" (on) or \"\" (off)")


def _count(value: str, key: str, where: str) -> int:
    if not re.fullmatch(r"\d+", value):
        err("00010", f"{where}: {key}=\"{value}\" -- a number")
    return int(value)


def _words(value: str, key: str, where: str) -> Tuple[str, ...]:
    try:
        return tuple(shlex.split(value))
    except ValueError as e:
        err("00011", f"{where}: {key}: {e}")


def load_settings(override: Optional[str]) -> Settings:
    """The config: the defaults, then <FILE>.GLOBAL, then <FILE> on top."""
    phase("reading the config")
    names: Dict[str, str] = {}
    defaults = read_config_text(DEFAULT_CONFIG, "the built-in defaults", names)
    chosen = override or os.environ.get("MY_OTR_CONFIG")
    if chosen:
        if not Path(chosen).is_file():
            err("00012", f"config '{chosen}' not found (--config / $MY_OTR_CONFIG)")
        found = Path(chosen)
    else:
        hits = [p for p in config_search_paths() if p.is_file()]
        if not hits:
            lines = "\n".join(f"        > {SCRIPT_NAME} --create-config > {p}" for p in config_offer())
            err("00013", f"no config found -- write one, most common place first:\n{lines}\n"
                         f"    ({SCRIPT_NAME} --help lists every place it is looked for)")
        found = hits[0]
    files = [p for p in (found.with_name(found.name + ".GLOBAL"), found) if p.is_file()]
    for p in files:
        try:
            text = p.read_text(encoding="utf-8")
        except OSError as e:
            err("00014", f"cannot read the config {p}: {e.strerror}")
        for key in read_config_text(text, str(p), names):
            if key not in defaults:
                OUT.warn(f"{p}: {key} is not a my-otr setting -- ignored ('{SCRIPT_NAME} --create-config' lists them)")
    where = " + ".join(str(p) for p in files)
    cap = names["OTR_QUALITY_CAP"]
    if cap not in ("HQ", "HD"):
        err("00015", f"{where}: OTR_QUALITY_CAP=\"{cap}\" -- HQ or HD")
    try:
        dl_params = tuple(shlex.split(names["OTR_DL_CMD_PARAMS"]))
    except ValueError as e:
        err("00016", f"{where}: OTR_DL_CMD_PARAMS: {e}")
    return Settings(
        files=tuple(files),
        datenkeller_login=names["DATENKELLER_LOGIN"], datenkeller_passw=names["DATENKELLER_PASSW"],
        datenkeller_apikey=names["DATENKELLER_APIKEY"],
        otr_login=names["OTR_LOGIN"], otr_passw=names["OTR_PASSW"],
        logfile=names["LOGFILE"], log=_flag(names["LOG"], "LOG", where),
        quiet=_flag(names["QUIET"], "QUIET", where), vrb=_flag(names["VRB"], "VRB", where),
        dbg=_flag(names["DBG"], "DBG", where), force=_flag(names["FORCE"], "FORCE", where),
        quality_cap="HD" if cap == "HD" else "HQ",
        dl_cmd=names["OTR_DL_CMD"], dl_params=dl_params,
        decode_dir=names["DEFAULT_DECODE_OUTP_DIR"], cookie_file=names["COOKIE_FILE"],
        recordings_file=Path(names["RECORDINGS_FILE"]).expanduser(), library_dir=names["LIBRARY_DIR"],
        sleep_seconds=_count(names["SLEEP_SECONDS"], "SLEEP_SECONDS", where),
        search_timeout=_count(names["SEARCH_TIMEOUT"], "SEARCH_TIMEOUT", where),
        get_timeout=_count(names["GET_TIMEOUT"], "GET_TIMEOUT", where),
        past_after_days=_count(names["PAST_AFTER_DAYS"], "PAST_AFTER_DAYS", where),
        fail_mail_cmd=_words(names["FAIL_MAIL_CMD"], "FAIL_MAIL_CMD", where),
        run_after_refresh=_words(names["RUN_AFTER_REFRESH"], "RUN_AFTER_REFRESH", where),
        run_as=names["RUN_AS"], run_at=names["RUN_AT"], launchd_label=names["LAUNCHD_LABEL"],
        launchd_log=names["LAUNCHD_LOG"], launchd_path=names["LAUNCHD_PATH"], fda_launcher=names["FDA_LAUNCHER"])


# --- 3. recordings: names, qualities, the search filter --------------------

# <Title>_<YY.MM.DD>_<HH-MM>_<channel>_<minutes>_TVOON_DE.<q>.<otrkey|otr2>
_OTR_NAME: Final = re.compile(
    r"^(?P<title>.+)_(?P<date>\d\d\.\d\d\.\d\d)_(?P<time>\d\d-\d\d)_(?P<channel>[^_]+)_(?P<minutes>\d+)"
    r"_TVOON_DE\.(?P<q>.+)\.(?P<fmt>otrkey|otr2)$")
# what follows "TVOON_DE." -- None: an add-on (a ZIP, an AC3 track), never a recording
_OTR_QUALITY: Final[Dict[str, Optional[Quality]]] = {
    "mpg.hq.avi": "HQ", "mpg.hd.avi": "HD", "mpg.avi": "DivX", "mpg.mp4": "MP4",  # .otrkey
    "mpg.hq.mp4": "HQ",                                                          # .otrkey, seen 2026-10
    "hq": "HQ", "hd": "HD", "lq": "LQ",                                         # .otr2
    "mpg.hq": "HQ", "mpg.hd": "HD", "mpg.lq": "LQ",                             # .otr2, named since 2026-08
    "mpg.addon": None, "mpg.hd.ac3": None,
}
_TAG_QUALITY: Final[Dict[str, Quality]] = {"hq": "HQ", "hd": "HD", "mp4": "MP4", "divx": "DivX", "lq": "LQ"}
WEEKDAYS: Final = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
Slot = Tuple[datetime.date, Tuple[int, int], str, int]


@dataclass(frozen=True)
class Recording:
    """One OTR file name, parsed."""

    name: str
    title: str
    day: datetime.date
    hhmm: Tuple[int, int]
    channel: str
    minutes: int
    quality: Optional[Quality]      # None: not a recording to take -- an add-on, or `unknown`
    unknown: str = ""               # the quality text, when it is one my-otr has not learned

    @property
    def slot(self) -> Slot:
        """What makes two names one recording: when, where, how long."""
        return (self.day, self.hhmm, self.channel.lower(), self.minutes)

    def slot_marks(self) -> Tuple[str, str]:
        """The slot as it appears in a local file name, lowercased: OTR's form, and
        the one of renamed files ("... [2026-10-04] [10h15] [zdf] [dur=100] [TVOON] [HQ].avi")."""
        d, (h, m) = self.day, self.hhmm
        return (f"_{d:%y.%m.%d}_{h:02d}-{m:02d}_{self.channel}_{self.minutes}_tvoon_de".lower(),
                f"[{d:%Y-%m-%d}] [{h:02d}h{m:02d}] [{self.channel}] [dur={self.minutes}] [tvoon]".lower())


def parse_otr_name(name: str) -> Optional[Recording]:
    """An OTR file name as a Recording; None when it is not one. A quality OTR
    has not used before is never guessed: the Recording has no quality and
    names the text in `unknown`, and the callers skip it, saying so."""
    m = _OTR_NAME.match(name)
    if m is None:
        return None
    q = m.group("q").lower()
    try:
        day = datetime.datetime.strptime(m.group("date"), "%y.%m.%d").date()
        hh, mm = (int(x) for x in m.group("time").split("-"))
        if hh > 23 or mm > 59:
            raise ValueError(m.group("time"))
    except ValueError:
        err("00017", f"'{name}': no valid date and time in it")
    return Recording(name, m.group("title"), day, (hh, mm), m.group("channel"),
                     int(m.group("minutes")), _OTR_QUALITY.get(q), "" if q in _OTR_QUALITY else m.group("q"))


def capped_rank(q: Quality, cap: QualityCap) -> int:
    return min(QUALITY_RANK[q], QUALITY_RANK[cap])


def local_quality(name: str) -> Optional[Quality]:
    """The quality of a file already here: a [HQ]/[HD]/[mp4]/[divx]/[LQ] tag
    (renamed files), else what follows OTR's "_TVOON_DE.". None: not a recording."""
    tag = re.search(r"\[(hq|hd|mp4|divx|lq)\]", name, re.IGNORECASE)
    if tag:
        return _TAG_QUALITY[tag.group(1).lower()]
    rest = name.lower().partition("_tvoon_de.")[2]
    for suffix in (".otrkey", ".otr2"):
        if rest.endswith(suffix):
            return _OTR_QUALITY.get(rest[:-len(suffix)])
    for form in (rest, rest.rsplit(".", 1)[0]):    # a decoded .otrkey: "mpg.hq.avi"; .otr2: "hq.mp4", "mpg.hq.mp4"
        if form in _OTR_QUALITY:
            return _OTR_QUALITY[form]
    return None


def unfinished(p: Path) -> bool:
    """aria2c's control file beside it: that download is not done."""
    return p.with_name(p.name + ".aria2").exists()


def copies_here(rec: Recording, folder: Path) -> List[Tuple[Path, Quality]]:
    """The finished files in `folder` that are this recording, with their quality."""
    marks = rec.slot_marks()
    found: List[Tuple[Path, Quality]] = []
    for p in sorted(folder.iterdir()):
        low = p.name.lower()
        if not any(mark in low for mark in marks) or low.endswith((".aria2", ".my-otr.part")):
            continue
        q = local_quality(p.name)
        if q is not None and p.is_file() and not unfinished(p):
            found.append((p, q))
    return found


def as_good_here(rec: Recording, q: Quality, folder: Path, cap: QualityCap) -> Optional[Tuple[Path, Quality]]:
    """A copy here as good as quality `q` of `rec`, or better -- above the cap,
    every quality counts as the cap."""
    for p, have in copies_here(rec, folder):
        if capped_rank(have, cap) >= capped_rank(q, cap):
            return p, have
    return None


@dataclass
class Filters:
    """What `search` keeps: every kind given must match (any of its values)."""

    title: List[str] = field(default_factory=lambda: [])
    channels: List[str] = field(default_factory=lambda: [])
    day_from: Optional[datetime.date] = None
    day_till: Optional[datetime.date] = None
    times: List[Tuple[int, int]] = field(default_factory=lambda: [])
    time_from: Optional[Tuple[int, int]] = None
    time_till: Optional[Tuple[int, int]] = None
    weekdays: List[int] = field(default_factory=lambda: [])
    durations: List[int] = field(default_factory=lambda: [])
    dur_from: Optional[int] = None
    dur_till: Optional[int] = None

    def keeps(self, rec: Recording) -> bool:
        if self.channels and rec.channel.lower() not in self.channels:
            return False
        if (self.day_from and rec.day < self.day_from) or (self.day_till and rec.day > self.day_till):
            return False
        if self.weekdays and rec.day.weekday() not in self.weekdays:
            return False
        if (self.times or self.time_from or self.time_till) and not self._time_ok(rec.hhmm):
            return False
        ranged = self.dur_from is not None or self.dur_till is not None
        if self.durations or ranged:
            lo = self.dur_from if self.dur_from is not None else 0
            hi = self.dur_till if self.dur_till is not None else 10 ** 6
            if rec.minutes not in self.durations and not (ranged and lo <= rec.minutes <= hi):
                return False
        return True

    def _time_ok(self, t: Tuple[int, int]) -> bool:
        if t in self.times:
            return True
        if self.time_from is None and self.time_till is None:
            return False
        def minute(hm: Tuple[int, int]) -> int:
            return hm[0] * 60 + hm[1]
        at = minute(t)
        lo = minute(self.time_from) if self.time_from else 0
        hi = minute(self.time_till) if self.time_till else 23 * 60 + 59
        return lo <= at <= hi if lo <= hi else (at >= lo or at <= hi)  # across midnight


def _hhmm(text: str, range_end: bool) -> Tuple[int, int]:
    """"20", "20h", "20:", "20:15", "20h15", "20-15" -- an hour alone is :00,
    or :59 as the end of a range."""
    m = re.fullmatch(r"(\d\d)(?:[:h-](\d\d)?)?", text)
    if m is None or int(m.group(1)) > 23 or (m.group(2) and int(m.group(2)) > 59):
        err("00018", f"'{text}' is not a time -- HH, HHh, HH:MM")
    minute = int(m.group(2)) if m.group(2) else (59 if range_end else 0)
    return int(m.group(1)), minute


def parse_filters(args: Sequence[str]) -> Filters:
    f = Filters()
    day_at: Optional[datetime.date] = None
    for a in args:
        if a == ",":
            err("00019", "a DESCRIPTION search (after ',') is not possible: otr.datenkeller.net's API answers no description")
        if re.fullmatch(r">\d{1,3}d", a):          # since N days ago: a recurring recording
            if f.day_from:
                err("00020", f"'{a}': one >DATE only")
            f.day_from = datetime.date.today() - datetime.timedelta(days=int(a[1:-1]))
        elif re.fullmatch(r"[@<>]\d{4}-\d\d-\d\d", a):
            try:
                day = datetime.date.fromisoformat(a[1:])
            except ValueError:
                err("00021", f"'{a}': no such date")
            if a[0] == "@":
                day_at = day
            elif a[0] == ">":
                if f.day_from:
                    err("00022", f"'{a}': one >DATE only")
                f.day_from = day
            else:
                if f.day_till:
                    err("00023", f"'{a}': one <DATE only")
                f.day_till = day
        elif re.fullmatch(r"[@<>]\d\d(?:[:h-]\d\d|[:h])", a):
            if a[0] == "@":
                f.times.append(_hhmm(a[1:], False))
            elif a[0] == ">":
                f.time_from = _hhmm(a[1:], False)
            else:
                f.time_till = _hhmm(a[1:], True)
        elif re.fullmatch(r"@[A-Za-z]{3}", a) and a[1:].lower() in WEEKDAYS:
            f.weekdays.append(WEEKDAYS.index(a[1:].lower()))
        elif re.fullmatch(r"[@<>]\d{1,3}", a):
            n = int(a[1:])
            if a[0] == "@":
                f.durations.append(n)
            elif a[0] == ">":
                f.dur_from = n
            else:
                f.dur_till = n
        elif a.startswith("@") and len(a) > 1:
            f.channels.append(a[1:].lower())
        elif a[:1] in ("<", ">"):
            err("00024", f"'{a}' is no filter ({SCRIPT_NAME} --help lists them)")
        else:
            f.title.append(a)
    if day_at:
        if f.day_from or f.day_till:
            err("00025", "@DATE together with <DATE or >DATE -- one or the other")
        f.day_from = f.day_till = day_at
    if not f.title:
        err("00026", "search needs a TITLE (what you would type into otr.datenkeller.net's search box)")
    return f


def preference(cap: QualityCap) -> List[Quality]:
    """The quality taken when a recording is offered in several: HQ, then the
    small ones, then HD -- HD first only when OTR_QUALITY_CAP is HD."""
    order: List[Quality] = ["HQ", "MP4", "DivX", "LQ", "HD"]
    return ["HD", *order[:-1]] if cap == "HD" else order


def pick_best(answer: str, filters: Filters, cap: QualityCap) -> Tuple[List[Recording], int]:
    """The search answer ("<file>;<size>..." per line) -> the best name of each
    recording the filters keep, oldest first; and how many files were offered."""
    by_slot: Dict[Tuple[Slot, str], Dict[Quality, Recording]] = {}
    unknown: Dict[str, List[str]] = {}
    offered = 0
    for n, line in enumerate(answer.splitlines(), 1):
        name = line.split(";", 1)[0].strip()
        if not name:
            continue
        offered += 1
        rec = parse_otr_name(name)
        if rec is None:
            err("00027", f"otr.datenkeller.net answered a line that is no OTR file (line {n}): {line[:100]}")
        if rec.unknown:
            unknown.setdefault(rec.unknown, []).append(name)
        elif rec.quality is None:
            OUT.dbg(f"an add-on, not a recording: {name}")
        elif not filters.keeps(rec):
            OUT.dbg(f"filtered out: {name}")
        else:
            by_slot.setdefault((rec.slot, rec.title.lower()), {})[rec.quality] = rec
    for q, names in sorted(unknown.items()):
        OUT.warn(f"{len(names)} file(s) in the quality '{q}' skipped -- my-otr does not know it yet "
                 f"(e.g. {names[0]})")
    best = [next(by_slot[k][q] for q in preference(cap) if q in by_slot[k]) for k in sorted(by_slot)]
    return best, offered


