def t_bootstrap(t: T) -> None:
    """The venv setup, offline (pip finds nothing): it leaves a complete venv or
    none -- never a half one, never the leftovers of a run before it."""
    venvs = t.dir / ".python.venv"
    venvs.mkdir()
    (venvs / ".my-otr.new.999999").mkdir()                      # left by a run killed outright
    (venvs / "my-otr" / "bin").mkdir(parents=True)
    (venvs / "my-otr" / "bin" / "python3").symlink_to("/nonexistent/python3.13")   # upgraded away
    env = {**os.environ, "HOME": str(t.dir), "PIP_NO_INDEX": "1", "PIP_FIND_LINKS": str(t.dir / "none")}
    me = os.path.realpath(__file__)
    p = subprocess.run([sys.executable, me, "--run-tests", "no-such-test"], env=env, capture_output=True, text=True, timeout=120)
    t.check(p.returncode == 1 and "ERROR 00001 [1]: cannot set up" in p.stderr, f"pip fails: rc {p.returncode}: {p.stderr}")
    t.check("has no python3 that runs -- built again" in p.stderr, f"the broken venv is said: {p.stderr}")
    t.check(sorted(x.name for x in venvs.iterdir()) == [], f"nothing left: {sorted(x.name for x in venvs.iterdir())}")
    # a caller's time limit: SIGTERM in the middle of the setup
    q = subprocess.Popen([sys.executable, me, "--run-tests", "no-such-test"], env=env, cwd="/", stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, text=True)
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline and not any(venvs.glob(".my-otr.new.*")):
        time.sleep(0.05)
    q.send_signal(signal.SIGTERM)
    _, errs = q.communicate(timeout=60)
    t.check(q.returncode == 143 and "stopped (SIGTERM) while setting up" in errs and "Traceback" not in errs,
            f"SIGTERM: rc {q.returncode}: {errs}")
    t.check(sorted(x.name for x in venvs.iterdir()) == [], f"no half venv after SIGTERM: {sorted(x.name for x in venvs.iterdir())}")


