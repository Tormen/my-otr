def cmd_search(s: Settings, args: Sequence[str]) -> int:
    filters = parse_filters(args)
    title = " ".join(filters.title)
    phase(f"searching for \"{title}\"")
    OUT.msg(f" >>> searching otr.datenkeller.net for \"{title}\"")
    answer = datenkeller_api(s, f"suche={urllib.parse.quote(title)}&details&limit=-1")
    if not answer.strip():
        err("00058", f"otr.datenkeller.net answered nothing for \"{title}\"")
    best, offered = pick_best(answer, filters, s.quality_cap)
    for rec in best:
        OUT.result(rec.name)
    OUT.msg(f"    > {len(best)} recording(s) [{offered} file(s) offered]")
    return 0


@dataclass
class Tally:
    read: int = 0
    skipped: int = 0
    downloaded: int = 0
    decoded: int = 0
    failed: List[str] = field(default_factory=lambda: [])


def cmd_get(s: Settings, decode: bool, force: bool) -> int:
    """Download the names (or URLs) on stdin into the current folder; then,
    unless --no-decode, decode every complete OTR file in it (#17)."""
    folder = Path.cwd()
    phase("reading the names on stdin")
    lines = [ln for ln in sys.stdin.read().splitlines() if ln.strip()]
    names = [name_of_line(ln) for ln in lines]   # every line checked before anything is fetched
    t = Tally(read=len(names))
    if names:
        datenkeller_login(s, force)
    for name in names:
        rec = parse_otr_name(name)
        assert rec is not None, "name_of_line returns names that parse"
        if rec.quality is None:
            OUT.det(f"    > {name}: an add-on, not a recording -- skipped")
            t.skipped += 1
            continue
        here = None if force else as_good_here(rec, rec.quality, folder, s.quality_cap)
        if here is not None:
            OUT.det(f"    > {name}: here already as {here[0].name} [{here[1]}] -- skipped")
            t.skipped += 1
            continue
        try:
            url = download_link(s, name)
            OUT.msg(f" >>> downloading {name}")
            aria2c(s, url, name, folder)
            t.downloaded += 1
        except OtrError as e:
            OUT.error(f"ERROR {e.code} [1]: {e.text}")
            t.failed.append(name)
    if decode:
        decode_all(s, sorted(p for p in folder.iterdir() if _kept_recording(p)), folder, force, t)
    OUT.msg(f" >>> {t.read} read: {t.skipped} skipped (here already), {t.downloaded} downloaded, "
            + (f"{t.decoded} decoded" if decode else "none decoded (--no-decode)")
            + (f", {len(t.failed)} FAILED" if t.failed else ""))
    if t.failed:
        err("00059", f"{len(t.failed)} failed: " + ", ".join(t.failed))
    return 0


def _kept_recording(p: Path) -> bool:
    """An OTR recording here, complete, to be decoded: never an add-on, never
    one aria2c is still writing."""
    if p.suffix.lower() not in (".otr2", ".otrkey") or not p.is_file() or unfinished(p):
        return False
    rec = parse_otr_name(p.name)
    return rec is not None and rec.quality is not None


def decode_all(s: Settings, files: Sequence[Path], outdir: Path, force: bool, t: Tally) -> None:
    """Decode each file; one that fails is named and the next one goes on."""
    session: Optional[OtrSession] = None
    for path in files:
        try:
            if not path.is_file():
                err("00060", f"{path}: no such file")
            out = outdir / decoded_name(path)
            if out.exists() and not force:
                OUT.msg(f"    > {path.name}: decoded already as {out.name} -- left as it is (-F decodes again)")
                t.skipped += 1
                continue
            session = session or OtrSession(s)
            written, check = decode_file(session, path, outdir)
            OUT.msg(f" >>> decoded {written.name} [{check}]")
            t.decoded += 1
        except OtrError as e:
            OUT.error(f"ERROR {e.code} [1]: {e.text}")
            t.failed.append(path.name)


def cmd_decode(s: Settings, args: Sequence[str], force: bool) -> int:
    """decode <FILE>.. [<DIR>]: a last argument that is a directory is where it writes."""
    items = list(args)
    if items == ["-"]:
        phase("reading the names on stdin")
        items = [ln.strip() for ln in sys.stdin.read().splitlines() if ln.strip()]
    if len(items) > 1 and Path(items[-1]).is_dir():
        outdir = Path(items.pop())
    elif s.decode_dir:
        outdir = Path(s.decode_dir).expanduser()
        OUT.msg(f" >>> writing into {outdir} (DEFAULT_DECODE_OUTP_DIR)")
        outdir.mkdir(parents=True, exist_ok=True)
    else:
        err("00061", "decode: no <DIR> given, and DEFAULT_DECODE_OUTP_DIR is not set")
    if not items:
        err("00062", "decode: no file given")
    t = Tally(read=len(items))
    decode_all(s, [Path(i) for i in items], outdir, force, t)
    if t.failed:
        err("00063", f"{len(t.failed)} of {t.read} failed: " + ", ".join(t.failed))
    return 0


def version_line() -> str:
    """The exact build: the version; git's describe where this file is tracked
    in its OWN repository (else the stamped commit); the hash of the bytes."""
    me = Path(os.path.realpath(__file__))
    build = hashlib.sha256(me.read_bytes()).hexdigest()[:12]
    desc = SCRIPT_COMMIT

    def git(*a: str) -> str:
        r = subprocess.run(["git", "-C", str(me.parent), *a], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""

    try:
        if git("remote", "get-url", "origin").endswith((REPOSITORY, REPOSITORY + ".git")) \
                and git("ls-files", me.name) == me.name:
            desc = git("describe", "--tags", "--long", "--always", "--dirty") or desc
    except (OSError, subprocess.SubprocessError):
        pass
    return f"{SCRIPT_NAME} {SCRIPT_VERSION} ({desc}, build {build})"


