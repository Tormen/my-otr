    t.check(f"recordings: 2 in {t.dir}/rec (1 recurring, 1 one-off), 1 outdated" in out, out)
    t.check("nightly: not installed" in out and "last run: none in the log" in out, out)
    log = t.dir / "log"
    log.write_text("2026-10-26 03:26:26 [1] other\n2026-10-26 03:26:27 [1]  >>> refresh: done [16 recording(s), 0 failed]\n")
    rc, out, _ = t.run(["--config", str(_t_rec_config(t, "", f'LOGFILE="{log}"\n'))])
    t.check("last run: 2026-10-26 03:26:27, 16 recording(s), 0 failed" in out, f"the last run, from the log: {out}")


def t_install(t: T) -> None:
    global _geteuid
    me = getpass.getuser()
    s = load_settings(str(_t_rec_config(t, "", f'RUN_AS="{me}"\nRUN_AT="03:31"\nLAUNCHD_LOG="/var/log/x.log"\n')))
    plain = plist_content(s, "/usr/local/bin/my-otr")
    t.check("<string>/usr/local/bin/my-otr</string>" in plain and f"<string>{me}</string>" in plain
            and "<key>HOME</key>" in plain and "<integer>3</integer>" in plain and "<integer>31</integer>" in plain,
            f"without a launcher: launchd runs my-otr as RUN_AS, with its HOME: {plain}")
    t.check(plain.count("<string>/var/log/x.log</string>") == 2 and "<key>PATH</key>" in plain,
            "stdout and stderr into LAUNCHD_LOG, and a PATH")
    s2 = load_settings(str(_t_rec_config(t, "", f'RUN_AS="{me}"\nRUN_AT="03:31"\nFDA_LAUNCHER="/bin/echo"\n')))
    via = plist_content(s2, "/usr/local/bin/my-otr")
    t.check("<string>/bin/echo</string>" in via and "UserName" not in via and "/usr/local/bin/my-otr" not in via,
            f"with a launcher: it runs first, as root, no UserName: {via}")
    for extra, want in (('RUN_AT="02:31"\n', "twice on the night"), ('RUN_AS=""\n', "RUN_AS is not set"),
                        ('RUN_AT="3:31"\n', "HH:MM")):
        rc, _, errs = t.run(["--config", str(_t_rec_config(t, "", f'RUN_AS="{me}"\n' + extra)), "--install"])
        t.check(rc == 1 and want in errs, f"{extra!r}: {errs}")
    _geteuid = lambda: 501
    try:
        rc, _, errs = t.run(["--config", str(_t_rec_config(t, "", f'RUN_AS="{me}"\nRUN_AT="03:31"\n')), "--install"])
    finally:
        _geteuid = os.geteuid
    t.check(rc == 1 and "needs root" in errs, errs)


def t_test_mail(t: T) -> None:
    conf = _t_rec_config(t, "")
    rc, _, errs = t.run(["--config", str(conf), "--test-mail"])
    mails = (t.dir / "mails").read_text() if (t.dir / "mails").exists() else ""
    t.check(rc == 0 and mails.count("test mail from") == 1 and "[rc 0]" in errs, f"{mails[:200]} {errs}")
