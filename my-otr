# TAP: the plan first, then "ok K - name" / "not ok K - name" as each ends.
# Nothing leaves the machine: the network is a fake server (_transport), the
# downloader a stub script, the secrets fake.

T_KEY = "K3y+S/ecr=t"           # quote() changes it: the raw AND the encoded form are looked for
T_KEY_ENC = "K3y%2BS/ecr%3Dt"
T_PASSW = "Pa55-w0rd&x"
T_OTR_PASSW = "0tr-Secr3t"


class T:
    """One test: its folder, its fake server, what it found wrong."""

    def __init__(self, folder: Path) -> None:
        self.dir = folder
        self.bad: List[str] = []
        self.requests: List[Tuple[str, str, bytes]] = []
        self.routes: Dict[str, Callable[[urllib.request.Request], Reply]] = {}

    def check(self, ok: bool, what: str) -> None:
        if not ok:
            self.bad.append(what)

    def serve(self, req: urllib.request.Request, timeout: float) -> Reply:
        body = req.data if isinstance(req.data, bytes) else b""
        self.requests.append((req.get_method(), req.full_url, body))
        for prefix, answer in self.routes.items():
            if req.full_url.startswith(prefix):
                return answer(req)
        raise urllib.error.URLError("no route in the test")

    def config(self, extra: str = "") -> Path:
        p = self.dir / "conf"
        p.write_text(f'DATENKELLER_LOGIN="tester"\nDATENKELLER_PASSW="{T_PASSW}"\nDATENKELLER_APIKEY="{T_KEY}"\n'
                     f'OTR_LOGIN="tester@x"\nOTR_PASSW="{T_OTR_PASSW}"\nLOG=""\n'
                     f'COOKIE_FILE="{self.dir}/cookies"\nOTR_DL_CMD="{self.dir}/aria2c"\nOTR_DL_CMD_PARAMS="-c"\n'
                     + extra, encoding="utf-8")
        return p

    def run(self, argv: Sequence[str], stdin: str = "") -> Tuple[int, str, str]:
        """The tool in-process, as from a shell: rc, stdout, stderr."""
        out, errs = io.StringIO(), io.StringIO()
        old_in = sys.stdin
        sys.stdin = io.StringIO(stdin)
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(errs):
                rc = main(list(argv))
        finally:
            sys.stdin = old_in
            OUT.__init__()
        return rc, out.getvalue(), errs.getvalue()

    def no_secret(self, text: str, where: str) -> None:
        for secret in (T_KEY, T_KEY_ENC, T_PASSW, urllib.parse.quote(T_PASSW), T_OTR_PASSW):
            self.check(secret not in text, f"a secret ({secret[:4]}...) in {where}")


def _t_stub_aria2c(t: T) -> None:
    """aria2c as the tests see it: records its argv and stdin, writes the out= file."""
    (t.dir / "aria2c").write_text(
        "#!/bin/sh\n"
        f"printf '%s\\n' \"$@\" > '{t.dir}/aria2c.argv'\n"
        f"cat > '{t.dir}/aria2c.stdin'\n"
        f"n=$(sed -n 's/^ *out=//p' '{t.dir}/aria2c.stdin')\n"
        "echo data > \"$n\"; rm -f \"$n.aria2\"\n", encoding="utf-8")
    (t.dir / "aria2c").chmod(0o755)


