def run_tests(name_filter: str) -> int:
    defined = {n for n in globals() if re.fullmatch(r"t_[a-z0-9_]+", n)}
    listed = {f.__name__ for f in TESTS}
    if defined != listed:
        print(f"Bail out! test functions and TESTS differ: {sorted(defined ^ listed)}")
        return 1
    chosen = [f for f in TESTS if name_filter in f.__name__]
    print(f"1..{len(chosen)}", flush=True)
    global _transport, _child
    real_child = list(_child)
    bad, home = 0, Path.cwd()
    for k, test in enumerate(chosen, 1):
        with tempfile.TemporaryDirectory(prefix="my-otr-tests.") as d:
            t = T(Path(d).resolve())
            os.chdir(t.dir)
            _transport = t.serve
            try:
                test(t)
            except Exception as e:   # a test that crashes fails, and the next one runs
                t.bad.append(f"crashed: {type(e).__name__}: {e}")
                t.bad.extend(traceback.format_exc().splitlines())
            finally:
                _transport = _urllib_transport
                _child = list(real_child)
                os.chdir(home)
                OUT.__init__()
        print(f"{'not ok' if t.bad else 'ok'} {k} - {test.__name__}", flush=True)
        for b in t.bad:
            print(f"#   {b}")
        bad += bool(t.bad)
    return 1 if bad else 0


def needs_venv(argv: Sequence[str]) -> bool:
    """Only decoding needs cryptography: the venv is set up for `decode`, `get`
    (unless --no-decode) and the tests -- never for --help, a search or a
    download, which then answer at once on a machine without it."""
    if argv[:1] and argv[0].partition("=")[0] == "--run-tests":
        return True
    try:
        c = parse_cli(argv)
    except OtrError:
        return False          # main says what is wrong with the arguments
    return c.command == "decode" or (c.command == "get" and not c.no_decode)


